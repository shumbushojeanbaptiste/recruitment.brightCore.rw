{
  "info": {
    "name": "BrightCore - Step 03 Authentication",
    "description": "Candidate registration, login, JWT protection, and seeded admin verification.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "candidateEmail",
      "value": ""
    },
    {
      "key": "candidatePassword",
      "value": "CandidatePass123!"
    },
    {
      "key": "candidateToken",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": "CHANGE_TO_YOUR_SEEDED_ADMIN_EMAIL"
    },
    {
      "key": "adminPassword",
      "value": "CHANGE_TO_YOUR_SEEDED_ADMIN_PASSWORD"
    },
    {
      "key": "adminToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Register Candidate",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('candidateEmail', 'candidate.' + Date.now() + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 201 Created', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json().data;",
              "pm.test('Creates a candidate, not an admin', function () { pm.expect(body.role).to.eql('candidate'); pm.expect(body.email).to.eql(pm.collectionVariables.get('candidateEmail')); });",
              "pm.test('Never returns the password hash', function () { pm.expect(body).not.to.have.property('password_hash'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Test Candidate\",\n  \"email\": \"{{candidateEmail}}\",\n  \"password\": \"{{candidatePassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      }
    },
    {
      "name": "02 - Login Candidate",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200 OK', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json().data;",
              "pm.test('Returns a bearer access token', function () { pm.expect(body.access_token).to.be.a('string').and.not.empty; pm.expect(body.token_type).to.eql('bearer'); pm.expect(body.expires_in).to.be.above(0); });",
              "pm.collectionVariables.set('candidateToken', body.access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{candidateEmail}}\",\n  \"password\": \"{{candidatePassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "03 - Candidate Identity (JWT Required)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200 OK', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json().data;",
              "pm.test('Returns the authenticated candidate', function () { pm.expect(body.role).to.eql('candidate'); pm.expect(body.email).to.eql(pm.collectionVariables.get('candidateEmail')); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{candidateToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/me"
      }
    },
    {
      "name": "04 - Identity Without Token (Expect 401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Rejects missing authentication', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/auth/me"
      }
    },
    {
      "name": "05 - Duplicate Registration (Expect 409)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Rejects duplicate email', function () { pm.response.to.have.status(409); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Duplicate Candidate\",\n  \"email\": \"{{candidateEmail}}\",\n  \"password\": \"{{candidatePassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      }
    },
    {
      "name": "06 - Login With Incorrect Password (Expect 401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Rejects incorrect credentials', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{candidateEmail}}\",\n  \"password\": \"WrongPassword123!\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "07 - Login Seeded Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin login succeeds', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json().data;",
              "pm.test('Returns an access token', function () { pm.expect(body.access_token).to.be.a('string').and.not.empty; });",
              "pm.collectionVariables.set('adminToken', body.access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "08 - Verify Admin Identity",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin identity is authenticated', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json().data;",
              "pm.test('User has the admin role', function () { pm.expect(body.role).to.eql('admin'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/me"
      }
    }
  ]
}
