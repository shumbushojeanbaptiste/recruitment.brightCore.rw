{
  "info": {
    "name": "BrightCore - Step 04 Jobs",
    "description": "Tests admin job management, publication lifecycle, public search, details, and authorization.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "adminEmail",
      "value": "CHANGE_TO_YOUR_SEEDED_ADMIN_EMAIL"
    },
    {
      "key": "adminPassword",
      "value": "CHANGE_TO_YOUR_SEEDED_ADMIN_PASSWORD"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "jobId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Admin Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin login returns 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json().data;",
              "pm.expect(body.access_token).to.be.a('string').and.not.empty;",
              "pm.collectionVariables.set('adminToken', body.access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "02 - Create Draft Job",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Draft created with 201', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json().data;",
              "pm.test('New job starts as draft', function () { pm.expect(body.status).to.eql('draft'); });",
              "pm.expect(body.id).to.be.a('string');",
              "pm.collectionVariables.set('jobId', body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Senior Backend Engineer Postman Test\",\n  \"department\": \"Engineering\",\n  \"location\": \"Kigali, Rwanda\",\n  \"employment_type\": \"full_time\",\n  \"description\": \"Build reliable backend APIs and services for the BrightCore recruitment platform. Collaborate with product and engineering teams.\",\n  \"requirements\": \"Strong Python skills, API development experience, SQL knowledge, and automated testing experience.\",\n  \"salary_min\": 1500000,\n  \"salary_max\": 2500000,\n  \"expires_at\": null\n}"
        },
        "url": "{{baseUrl}}/api/v1/admin/jobs"
      }
    },
    {
      "name": "03 - Draft Not Public",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Draft detail is hidden publicly', function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/jobs/{{jobId}}"
      }
    },
    {
      "name": "04 - Publish Job",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Publish succeeds', function () { pm.response.to.have.status(200); });",
              "pm.test('Job is published', function () { pm.expect(pm.response.json().data.status).to.eql('published'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/admin/jobs/{{jobId}}/publish"
      }
    },
    {
      "name": "05 - Public Search Published Job",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Public search succeeds', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json().data;",
              "pm.test('Published job appears in results', function () { pm.expect(body.items.some(item => item.id === pm.collectionVariables.get('jobId'))).to.eql(true); });",
              "pm.test('Pagination metadata exists', function () { pm.expect(body.total).to.be.a('number'); pm.expect(body.page).to.eql(1); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/jobs?q=Senior%20Backend%20Engineer%20Postman%20Test&page=1&page_size=10"
      }
    },
    {
      "name": "06 - Public Job Detail",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Published detail returns 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Returned ID matches', function () { pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('jobId')); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/jobs/{{jobId}}"
      }
    },
    {
      "name": "07 - Update Job",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Update succeeds', function () { pm.response.to.have.status(200); });",
              "pm.test('Updated title is returned', function () { pm.expect(pm.response.json().data.title).to.eql('Senior Backend Engineer - Updated'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Senior Backend Engineer - Updated\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/admin/jobs/{{jobId}}"
      }
    },
    {
      "name": "08 - Close Job",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Close succeeds', function () { pm.response.to.have.status(200); });",
              "pm.test('Job is closed', function () { pm.expect(pm.response.json().data.status).to.eql('closed'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/admin/jobs/{{jobId}}/close"
      }
    },
    {
      "name": "09 - Closed Job Not Public",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Closed job returns 404 publicly', function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/jobs/{{jobId}}"
      }
    },
    {
      "name": "10 - Admin Endpoint Without Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin endpoint rejects missing token', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/admin/jobs"
      }
    }
  ]
}
