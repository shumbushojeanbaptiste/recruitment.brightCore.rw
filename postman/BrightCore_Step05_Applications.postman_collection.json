{
  "info": {
    "name": "BrightCore - Step 05 Applications",
    "description": "End-to-end test for job applications, duplicate prevention, status management, and private CV downloads.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "adminEmail",
      "value": "CHANGE_TO_YOUR_SEEDED_ADMIN_EMAIL"
    },
    {
      "key": "adminPassword",
      "value": "CHANGE_TO_YOUR_SEEDED_ADMIN_PASSWORD"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "jobId",
      "value": ""
    },
    {
      "key": "applicationId",
      "value": ""
    },
    {
      "key": "candidateEmail",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Admin Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin login succeeds', function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set('adminToken', pm.response.json().data.access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "02 - Create Test Job",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Job created', function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('jobId', pm.response.json().data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Application Workflow Test Engineer\",\n  \"department\": \"Engineering\",\n  \"location\": \"Kigali, Rwanda\",\n  \"employment_type\": \"full_time\",\n  \"description\": \"Test vacancy created by the application workflow collection. It is used to verify candidate submissions and private document handling.\",\n  \"requirements\": \"Experience testing APIs, understanding databases, and writing clear test cases.\",\n  \"salary_min\": 1000000,\n  \"salary_max\": 2000000,\n  \"expires_at\": null\n}"
        },
        "url": "{{baseUrl}}/api/v1/admin/jobs"
      }
    },
    {
      "name": "03 - Publish Test Job",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Job published', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data.status).to.eql('published'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/admin/jobs/{{jobId}}/publish"
      }
    },
    {
      "name": "04 - Submit Application (Select PDF File)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('candidateEmail', 'applicant.' + Date.now() + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Application created', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json().data;",
              "pm.test('Application starts submitted', function () { pm.expect(body.status).to.eql('submitted'); });",
              "pm.test('CV metadata returned without private key', function () { pm.expect(body.cv_original_filename).to.be.a('string'); pm.expect(body).not.to.have.property('cv_storage_key'); pm.expect(body).not.to.have.property('cv_sha256'); });",
              "pm.collectionVariables.set('applicationId', body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "full_name",
              "value": "Test Candidate",
              "type": "text"
            },
            {
              "key": "email",
              "value": "{{candidateEmail}}",
              "type": "text"
            },
            {
              "key": "phone",
              "value": "+250788123456",
              "type": "text"
            },
            {
              "key": "cover_note",
              "value": "I am interested in this role and believe my technical experience is relevant.",
              "type": "text"
            },
            {
              "key": "cv",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/jobs/{{jobId}}/applications"
      }
    },
    {
      "name": "05 - Duplicate Application (Expect 409)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Duplicate application rejected', function () { pm.response.to.have.status(409); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "full_name",
              "value": "Test Candidate",
              "type": "text"
            },
            {
              "key": "email",
              "value": "{{candidateEmail}}",
              "type": "text"
            },
            {
              "key": "phone",
              "value": "+250788123456",
              "type": "text"
            },
            {
              "key": "cv",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/jobs/{{jobId}}/applications"
      }
    },
    {
      "name": "06 - Admin List Applications",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Application list succeeds', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json().data;",
              "pm.test('New application is listed', function () { pm.expect(body.items.some(item => item.id === pm.collectionVariables.get('applicationId'))).to.eql(true); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/admin/applications?page=1&page_size=20&job_id={{jobId}}"
      }
    },
    {
      "name": "07 - Download Private CV",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('CV download succeeds', function () { pm.response.to.have.status(200); });",
              "pm.test('Response is a PDF', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/admin/applications/{{applicationId}}/cv"
      }
    },
    {
      "name": "08 - Move Application Under Review",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status update succeeds', function () { pm.response.to.have.status(200); });",
              "pm.test('Application is under review', function () { pm.expect(pm.response.json().data.status).to.eql('under_review'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"under_review\",\n  \"note\": \"Initial screening started.\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/admin/applications/{{applicationId}}/status"
      }
    },
    {
      "name": "09 - Admin Applications Without Token (Expect 401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Protected endpoint rejects missing token', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/admin/applications"
      }
    }
  ]
}
